<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>uk.ac.ebi.tsc</groupId>
    <artifactId>tesk</artifactId>
    <version>2.1.0</version>
    <packaging>jar</packaging>

    <name>tesk</name>
    <description>TESK (TES on Kubernetes) API</description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <java.version>21</java.version>
        <!-- Dependency versions -->
        <springdoc.version>3.2.0</springdoc.version>
        <kubernetes.client-java.version>28.0.0</kubernetes.client-java.version>
        <jose4j.version>0.9.7</jose4j.version>

        <guava.version>33.8.0-jre</guava.version>
        <!-- What the Kubernetes client needs, newer than what Spring Boot manages (the client's
             parent POM, io.kubernetes:client-java-parent): update them together with it -->
        <snakeyaml.version>2.7</snakeyaml.version>
        <gson.version>2.14.0</gson.version>
        <commons-lang3.version>3.21.0</commons-lang3.version>
        <commons-codec.version>1.23.0</commons-codec.version>
        <maven-surefire-plugin.version>3.6.1</maven-surefire-plugin.version>
        <apache.commons.collections4.version>4.6.0</apache.commons.collections4.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- RestTemplateBuilder (TRS client) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Security + OAuth2 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Bearer tokens, validated at the user info endpoint (OpaqueTokenIntrospector) -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-resource-server</artifactId>
        </dependency>
        <!-- Checks the JWT access tokens of service clients (issue #153); also used by the
             Kubernetes client: the version of its parent POM -->
        <dependency>
            <groupId>org.bitbucket.b_c</groupId>
            <artifactId>jose4j</artifactId>
            <version>${jose4j.version}</version>
        </dependency>
        <!--Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- API description (OpenAPI 3) and Swagger UI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <!--Kubernetes client -->
        <dependency>
            <groupId>io.kubernetes</groupId>
            <artifactId>client-java</artifactId>
            <version>${kubernetes.client-java.version}</version>
        </dependency>
        <!--Guava-->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>${guava.version}</version>
        </dependency>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-collections4</artifactId>
            <version>${apache.commons.collections4.version}</version>
        </dependency>
        <!--Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring Security in the test slices (e.g. @WebMvcTest), and spring-security-test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>3.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Sets the path of each dependency as a property (e.g.
                 `${org.mockito:mockito-core:jar}`), for the agents of the tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>7.27.0</version>
                <executions>
                    <execution>
                        <id>generate</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>tes/openapi/task_execution_service.openapi.yaml</inputSpec>
                            <modelPackage>uk.ac.ebi.tsc.tesk.tes.model</modelPackage>
                            <apiPackage>uk.ac.ebi.tsc.tesk.tes.api</apiPackage>
                            <generatorName>spring</generatorName>
                            <output>${project.build.sourceDirectory}</output>
                            <addCompileSourceRoot>false</addCompileSourceRoot>
                            <generateApiDocumentation>false</generateApiDocumentation>
                            <generateModelDocumentation>false</generateModelDocumentation>
                            <generateSupportingFiles>true</generateSupportingFiles>
                            <supportingFilesToGenerate>ApiUtil.java</supportingFilesToGenerate>
                            <ignoreFileOverride>${project.basedir}/.swagger-codegen-ignore</ignoreFileOverride>
                            <typeMappings>URI=String</typeMappings>
                            <configOptions>
                                <sourceFolder>./</sourceFolder>
                                <openApiNullable>false</openApiNullable>
                                <useSpringBoot3>true</useSpringBoot3>
                                <useJakartaEe>true</useJakartaEe>
                            </configOptions>
                            <skip>${skip.generate.swagger.sources}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-test-source</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>src/integration-test/java</source>
                            </sources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>add-resource</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>add-test-resource</goal>
                        </goals>
                        <configuration>
                            <resources>
                                <resource>
                                    <directory>src/integration-test/resources</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <useSystemClassLoader>false</useSystemClassLoader>
                    <!-- JaCoCo's agent (`argLine`, set by prepare-agent) and Mockito's agent
                         (inline mocks; loaded at startup, as Java 21 and later warn about agents
                         loaded later and may refuse them) -->
                    <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <useSystemClassLoader>false</useSystemClassLoader>
                    <!-- JaCoCo's agent and Mockito's, as for the unit tests -->
                    <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.16</version>
                <!-- Coverage must be 100% (check below), except for:
                     - the files generated by openapi-generator from the TES specification
                       (src/main/java/.openapi-generator/FILES, also excluded from Spotless and
                       Checkstyle; keep the lists the same): data classes and the stubs of the
                       API, whose default methods the controllers override;
                     - TeskApplication: the entry point only starts Spring Boot, as the tests do
                       with the same configuration (@SpringBootTest). -->
                <configuration>
                    <excludes>
                        <exclude>uk/ac/ebi/tsc/tesk/tes/api/ApiUtil.class</exclude>
                        <exclude>uk/ac/ebi/tsc/tesk/tes/api/ServiceInfoApi.class</exclude>
                        <exclude>uk/ac/ebi/tsc/tesk/tes/api/TasksApi.class</exclude>
                        <exclude>uk/ac/ebi/tsc/tesk/tes/model/Service.class</exclude>
                        <exclude>uk/ac/ebi/tsc/tesk/tes/model/ServiceOrganization.class</exclude>
                        <exclude>uk/ac/ebi/tsc/tesk/tes/model/ServiceType.class</exclude>
                        <exclude>uk/ac/ebi/tsc/tesk/tes/model/TesCreateTaskResponse.class</exclude>
                        <exclude>uk/ac/ebi/tsc/tesk/tes/model/TesExecutor.class</exclude>
                        <exclude>uk/ac/ebi/tsc/tesk/tes/model/TesExecutorLog.class</exclude>
                        <exclude>uk/ac/ebi/tsc/tesk/tes/model/TesFileType.class</exclude>
                        <exclude>uk/ac/ebi/tsc/tesk/tes/model/TesInput.class</exclude>
                        <exclude>uk/ac/ebi/tsc/tesk/tes/model/TesListTasksResponse.class</exclude>
                        <exclude>uk/ac/ebi/tsc/tesk/tes/model/TesOutput.class</exclude>
                        <exclude>uk/ac/ebi/tsc/tesk/tes/model/TesOutputFileLog.class</exclude>
                        <exclude>uk/ac/ebi/tsc/tesk/tes/model/TesResources.class</exclude>
                        <exclude>uk/ac/ebi/tsc/tesk/tes/model/TesServiceInfo.class</exclude>
                        <exclude>uk/ac/ebi/tsc/tesk/tes/model/TesServiceInfoAllOf.class</exclude>
                        <exclude>uk/ac/ebi/tsc/tesk/tes/model/TesServiceType.class</exclude>
                        <exclude>uk/ac/ebi/tsc/tesk/tes/model/TesServiceType$*.class</exclude>
                        <exclude>uk/ac/ebi/tsc/tesk/tes/model/TesServiceTypeAllOf.class</exclude>
                        <exclude>uk/ac/ebi/tsc/tesk/tes/model/TesServiceTypeAllOf$*.class</exclude>
                        <exclude>uk/ac/ebi/tsc/tesk/tes/model/TesState.class</exclude>
                        <exclude>uk/ac/ebi/tsc/tesk/tes/model/TesTask.class</exclude>
                        <exclude>uk/ac/ebi/tsc/tesk/tes/model/TesTaskLog.class</exclude>
                        <exclude>uk/ac/ebi/tsc/tesk/TeskApplication.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>default-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>default-report</id>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>default-prepare-agent-integration</id>
                        <goals>
                            <goal>prepare-agent-integration</goal>
                        </goals>
                    </execution>
                    <execution>
                        <goals>
                            <goal>report-integration</goal>
                        </goals>
                    </execution>
                    <!-- Coverage target: the unit and integration tests together must cover all lines and branches
                         (`./mvnw verify` fails otherwise), as Codecov checks too (`codecov.yml`) -->
                    <execution>
                        <id>merge</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>merge</goal>
                        </goals>
                        <configuration>
                            <fileSets>
                                <fileSet>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>jacoco.exec</include>
                                        <include>jacoco-it.exec</include>
                                    </includes>
                                </fileSet>
                            </fileSets>
                            <destFile>${project.build.directory}/jacoco-merged.exec</destFile>
                        </configuration>
                    </execution>
                    <!-- The report of the merged data, which Codecov receives: like the check, it
                         counts a branch as covered if either suite covers it -->
                    <execution>
                        <id>report-merged</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
                            <outputDirectory>${project.reporting.outputDirectory}/jacoco-merged</outputDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.00</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.00</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Formatting (google-java-format, AOSP style) and lint (checkstyle.xml):
                 ./mvnw spotless:apply to format, ./mvnw spotless:check checkstyle:check to check
                 (CI job Lint). -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <java>
                        <includes>
                            <include>src/main/java/**/*.java</include>
                            <include>src/test/java/**/*.java</include>
                            <include>src/integration-test/java/**/*.java</include>
                        </includes>
                        <excludes>
                            <!-- Generated (src/main/java/.openapi-generator/FILES);
                                 keep in sync with the filter in checkstyle.xml -->
                            <exclude>src/main/java/uk/ac/ebi/tsc/tesk/tes/api/ApiUtil.java</exclude>
                            <exclude>src/main/java/uk/ac/ebi/tsc/tesk/tes/api/ServiceInfoApi.java</exclude>
                            <exclude>src/main/java/uk/ac/ebi/tsc/tesk/tes/api/TasksApi.java</exclude>
                            <exclude>src/main/java/uk/ac/ebi/tsc/tesk/tes/model/Service.java</exclude>
                            <exclude>src/main/java/uk/ac/ebi/tsc/tesk/tes/model/ServiceOrganization.java</exclude>
                            <exclude>src/main/java/uk/ac/ebi/tsc/tesk/tes/model/ServiceType.java</exclude>
                            <exclude>src/main/java/uk/ac/ebi/tsc/tesk/tes/model/TesCreateTaskResponse.java</exclude>
                            <exclude>src/main/java/uk/ac/ebi/tsc/tesk/tes/model/TesExecutor.java</exclude>
                            <exclude>src/main/java/uk/ac/ebi/tsc/tesk/tes/model/TesExecutorLog.java</exclude>
                            <exclude>src/main/java/uk/ac/ebi/tsc/tesk/tes/model/TesFileType.java</exclude>
                            <exclude>src/main/java/uk/ac/ebi/tsc/tesk/tes/model/TesInput.java</exclude>
                            <exclude>src/main/java/uk/ac/ebi/tsc/tesk/tes/model/TesListTasksResponse.java</exclude>
                            <exclude>src/main/java/uk/ac/ebi/tsc/tesk/tes/model/TesOutput.java</exclude>
                            <exclude>src/main/java/uk/ac/ebi/tsc/tesk/tes/model/TesOutputFileLog.java</exclude>
                            <exclude>src/main/java/uk/ac/ebi/tsc/tesk/tes/model/TesResources.java</exclude>
                            <exclude>src/main/java/uk/ac/ebi/tsc/tesk/tes/model/TesServiceInfo.java</exclude>
                            <exclude>src/main/java/uk/ac/ebi/tsc/tesk/tes/model/TesServiceInfoAllOf.java</exclude>
                            <exclude>src/main/java/uk/ac/ebi/tsc/tesk/tes/model/TesServiceType.java</exclude>
                            <exclude>src/main/java/uk/ac/ebi/tsc/tesk/tes/model/TesServiceTypeAllOf.java</exclude>
                            <exclude>src/main/java/uk/ac/ebi/tsc/tesk/tes/model/TesState.java</exclude>
                            <exclude>src/main/java/uk/ac/ebi/tsc/tesk/tes/model/TesTask.java</exclude>
                            <exclude>src/main/java/uk/ac/ebi/tsc/tesk/tes/model/TesTaskLog.java</exclude>
                        </excludes>
                        <googleJavaFormat>
                            <version>2.0.0</version>
                            <style>AOSP</style>
                        </googleJavaFormat>
                        <removeUnusedImports/>
                    </java>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.6.0</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>14.4.0</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <configLocation>checkstyle.xml</configLocation>
                    <consoleOutput>true</consoleOutput>
                    <failOnViolation>true</failOnViolation>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <testSourceDirectories>
                        <testSourceDirectory>${project.basedir}/src/test/java</testSourceDirectory>
                        <testSourceDirectory>${project.basedir}/src/integration-test/java</testSourceDirectory>
                    </testSourceDirectories>
                    <!-- Generated files are suppressed in checkstyle.xml -->
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>default</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <skip.generate.swagger.sources>true</skip.generate.swagger.sources>
            </properties>
        </profile>
        <profile>
            <id>generate-swagger</id>
            <properties>
                <skip.generate.swagger.sources>false</skip.generate.swagger.sources>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-clean-plugin</artifactId>
                        <configuration>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.sourceDirectory}/uk/ac/ebi/tsc/tesk/model</directory>
                                </fileset>
                            </filesets>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
